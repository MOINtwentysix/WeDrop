# Neon pooled Postgres connection string. Never expose this to the browser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# Generate independent random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CRON_SECRET=
# Canonical public origin, without a trailing slash. Use HTTPS in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of the corresponding source code for your deployed AGPL version.
NEXT_PUBLIC_SOURCE_URL=https://github.com/YOUR-USERNAME/wedrop
